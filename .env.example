# Скопируйте в .env и подставьте свои значения.
# Для локального демо достаточно DEBUG и SECRET_KEY: база по умолчанию — SQLite.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# sqlite (по умолчанию) или mysql
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# Нужны только если DB_ENGINE=mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# SMTP для отправки PDF заявок менеджеру. Без этих полей заявка только в БД.
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Куда слать PDF. Пусто = письмо НЕ отправляется. Не путайте с email на витрине сайта.
ORDER_NOTIFICATION_EMAIL=
# Получатель для скрипта check_email.py
EMAIL_TEST_RECIPIENT=

# Ключ JavaScript API Яндекс.Карт. Без него блок карты просто не рисуется.
YANDEX_MAPS_API_KEY=

# Админ для /admin/ на хостинге (создаётся при старте, если пользователя ещё нет)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
